# ─── Database ────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string (replace with your actual URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# ─── JWT & Security ──────────────────────────────────────────────────────────
# Change these values to strong random secrets in production
JWT_SECRET=sentinel-flow-super-secret-jwt-key-change-me
PASSWORD_SALT=sf-salt-2024-change-me

# ─── Service URLs (used by api-gateway) ──────────────────────────────────────
AUTH_SERVICE_URL=http://localhost:8001
ACCOUNT_SERVICE_URL=http://localhost:8002
TRANSACTION_SERVICE_URL=http://localhost:8003
RISK_SERVICE_URL=http://localhost:8004
NOTIFICATION_SERVICE_URL=http://localhost:8005

# ─── Rate Limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=100

# ─── Risk Thresholds ─────────────────────────────────────────────────────────
AML_THRESHOLD_HIGH=500000
AML_THRESHOLD_MED=100000
FREQ_TRANSFER_LIMIT=10
LARGE_TX_THRESHOLD=500000

# ─── Black Duck SCA ──────────────────────────────────────────────────────────
BLACKDUCK_URL=https://<blackduck-host>
BLACKDUCK_API_TOKEN=<blackduck-api-token>
BLACKDUCK_TRUST_CERT=true

# ─── IBM watsonx Orchestrate ─────────────────────────────────────────────────
WATSONX_API_KEY=<your-watsonx-api-key>
WATSONX_PROJECT_ID=<your-watsonx-project-id>
WATSONX_URL=https://us-south.ml.cloud.ibm.com

# ─── BlackDuck API Service ────────────────────────────────────────────────────
BLACKDUCK_SERVICE_URL=http://localhost:8006
