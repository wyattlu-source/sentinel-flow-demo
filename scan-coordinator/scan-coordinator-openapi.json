          },
          "fix_packages": {
            "title": "Fix Packages",
            "description": "Structured list of packages to upgrade. Each entry MUST be in 'package>=version' format, e.g. ['urllib3>=2.6.3', 'PyJWT>=2.12.0']. When provided, this takes precedence over parsing the details field. Use this for precise, unambiguous version pinning.",
